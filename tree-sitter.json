{
  "grammars": [
    {
      "name": "commonlisp",
      "camelcase": "CommonLisp",
      "scope": "source.cl",
      "path": ".",
      "file-types": [
        "cl",
        "lisp"
      ],
      "highlights": [
        "node_modules/tree-sitter-clojure/queries/highlights.scm"
      ],
      "tags": [
        "queries/tags.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.4.1",
    "license": "MIT",
    "description": "Common Lisp grammar for tree-sitter",
    "authors": [
      {
        "name": "Stephan Seitz"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-commonlisp"
    }
  }
}
